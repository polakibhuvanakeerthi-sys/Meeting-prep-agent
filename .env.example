# MeetMind AI Environment Variables Template
# Copy this file to .env and configure your keys if using custom external AI providers

# Optional External AI Provider Keys (Default runs in high-performance local simulated mode)
OPENAI_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Application Port (default: 5173)
VITE_PORT=5173
